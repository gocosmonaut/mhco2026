<?php

/**
 * @file
 * MHCO Caching Fixes.
 */

use Drupal\Core\Session\AccountInterface;

/**
 * Implements hook_user_login().
 */
function mhco_caching_user_login(AccountInterface $account)
{
  // 1. Invalidate Drupal's internal cache tags for this specific user
  $tags = [
    'user:' . $account->id(),
    'user_list',
    'route_match',
  ];
  \Drupal::service('cache_tags.invalidator')->invalidateTags($tags);

  // 2. Safely force the redirect by setting the destination query parameter
  $request = \Drupal::request();
  // Ensure we don't override an existing destination if they are logging in from a specific protected page, 
  // or remove the 'has' check if you want to force this 100% of the time regardless of where they logged in from.
  if (!$request->query->has('destination')) {
    $request->query->set('destination', '/user/' . $account->id());
  }

  // 3. Log the action
  \Drupal::logger('mhco_caching')->notice('User @uid logged in. Cleared cache and set redirect to profile.', ['@uid' => $account->id()]);
}
